# GEMINI_API_KEY: Required for Gemini AI Agent calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted. (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# Google OAuth 2.0 credentials (from your Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Dropbox OAuth 2.0 credentials (from Dropbox App Console: https://www.dropbox.com/developers/apps)
# Permissions needed: files.metadata.read, files.metadata.write, files.content.read, files.content.write, account_info.read
# (DROPBOX_APP_KEY and DROPBOX_APP_SECRET are also accepted aliases)
DROPBOX_CLIENT_ID="your_dropbox_app_key_here"
DROPBOX_CLIENT_SECRET="your_dropbox_app_secret_here"
DROPBOX_REDIRECT_URI="http://localhost:3000/api/auth/callback/dropbox"

# Microsoft OneDrive / Azure AD credentials (from Microsoft Entra / Azure Portal: https://portal.azure.com)
# Permissions needed: offline_access, Files.ReadWrite, User.Read
# (AZURE_CLIENT_ID and MICROSOFT_CLIENT_ID are also accepted aliases)
ONEDRIVE_CLIENT_ID="your_microsoft_client_id_here"
ONEDRIVE_CLIENT_SECRET="your_microsoft_client_secret_here"
ONEDRIVE_REDIRECT_URI="http://localhost:3000/api/auth/callback/onedrive"

# Optional: Session encryption secret for tokens and cryptographic confirmation tokens (defaults to GOOGLE_CLIENT_SECRET if omitted)
# SESSION_SECRET="your_session_secret_here"
